<Window x:Class="appwritewpftrae20260118.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="訂閱管理器"
        Height="820"
        Width="1360"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#09111F"
        FontFamily="Segoe UI Variable Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#0C1628" />
        <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#111E34" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#304567" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#8EA1BD" />
        <SolidColorBrush x:Key="StrongTextBrush" Color="#F3F7FC" />
        <SolidColorBrush x:Key="HighlightDeepBrush" Color="#4A79C7" />
        <SolidColorBrush x:Key="HighlightSoftBrush" Color="#9EC1FF" />
        <SolidColorBrush x:Key="WarmPanelBrush" Color="#271E12" />
        <SolidColorBrush x:Key="WarmBorderBrush" Color="#7E6336" />
        <SolidColorBrush x:Key="WarmTextBrush" Color="#F6DDA0" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#84E0C2" />
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101C" Offset="0" />
            <GradientStop Color="#0A1525" Offset="0.42" />
            <GradientStop Color="#10203A" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Background" Value="{StaticResource HighlightDeepBrush}" />
            <Setter Property="BorderBrush" Value="#A5C5FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <Grid>
                                <Border Margin="1" CornerRadius="15" Opacity="0.6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#D3E3FF" Offset="0" />
                                            <GradientStop Color="#6E9EE9" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#AFC2E1" />
            <Setter Property="Background" Value="#13233B" />
            <Setter Property="BorderBrush" Value="#2F496F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#17253C" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="#233553" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Foreground" Value="#EAF1FA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#101C31" />
            <Setter Property="Foreground" Value="#EAF1FA" />
            <Setter Property="BorderBrush" Value="#1A2A45" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#172943" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#21426D" />
                    <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="420" Height="420" Canvas.Left="-110" Canvas.Top="-120" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A6C0FF" Offset="0" />
                        <GradientStop Color="#26456B" Offset="0.55" />
                        <GradientStop Color="#00101A" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="520" Height="520" Canvas.Right="-180" Canvas.Bottom="-210" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#DCE7FF" Offset="0" />
                        <GradientStop Color="#385B86" Offset="0.5" />
                        <GradientStop Color="#06111C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
        <Border Margin="26" CornerRadius="30" Background="#0B1526" BorderBrush="#25395A" BorderThickness="1">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorderStyle}" Padding="24" Margin="0,0,20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border Background="#16243B" BorderBrush="#345079" BorderThickness="1" CornerRadius="999" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="DESKTOP CONTROL SURFACE" Foreground="#B2C6E8" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding CurrentPageTitle}" Margin="0,16,0,0" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource StrongTextBrush}" />
                                <TextBlock Text="{Binding CurrentPageSubtitle}" Margin="0,10,0,0" Style="{StaticResource InfoTextStyle}" FontSize="14" MaxWidth="700" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="22" Background="#14253E" BorderBrush="#29456B" BorderThickness="1" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SYSTEM STATUS" Foreground="#8EAAD2" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{Binding ActiveStatusMessage}" Foreground="{StaticResource StrongTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Width="184" Style="{StaticResource PanelBorderStyle}" Background="#0F1E34" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ACTION" Foreground="#7F9BC4" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Button x:Name="RefreshButton" Content="{Binding CurrentActionLabel}" Height="46" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="18" Background="#0F1B2F">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="訂閱總覽" Style="{StaticResource MenuButtonStyle}" Click="SubscriptionsMenuButton_Click" />
                            <Button Content="原油監測" Style="{StaticResource MenuButtonStyle}" Margin="0" Click="OilMonitorMenuButton_Click" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#162640" BorderBrush="#2A4264" BorderThickness="1" CornerRadius="999" Padding="12,6">
                            <TextBlock Text="{Binding ActiveStatusMessage}" Foreground="#C0D2F1" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="4">
                    <Grid Visibility="{Binding IsSubscriptionView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="NotificationPanel" Grid.Row="0" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource WarmPanelBrush}" BorderBrush="{StaticResource WarmBorderBrush}" Padding="18">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Ellipse Width="10" Height="10" Fill="#E7C46C" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="即將到期提醒" Foreground="{StaticResource WarmTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="SUBSCRIPTION ALERTS" Foreground="#C7AF7A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <ItemsControl x:Name="NotificationList" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="14" Background="#2F2517" BorderBrush="#8E7040" BorderThickness="1">
                                                <TextBlock Text="{Binding}" Foreground="#F7E0AD" FontSize="13" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="1" Background="{StaticResource WindowSurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#111E33" BorderBrush="#203150" BorderThickness="0,0,0,1" CornerRadius="23,23,0,0" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SUBSCRIPTION MATRIX" Foreground="{StaticResource StrongTextBrush}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Appwrite Databases / SUBSCRIPTION" Foreground="#839CC0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Subscriptions}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="#101C31" AlternatingRowBackground="#122038" Background="{StaticResource WindowSurfaceBrush}" Foreground="#E5EDF8" HorizontalGridLinesBrush="#1A2A45" VerticalGridLinesBrush="#1A2A45" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeRows="False" RowHeight="42" ColumnHeaderHeight="42" CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource DataGridRowStyle}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" SelectionMode="Extended" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="140" />
                                        <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="170" />
                                        <DataGridTextColumn Header="網站" Binding="{Binding Site}" Width="220" />
                                        <DataGridTextColumn Header="價格" Binding="{Binding Price}" Width="92" />
                                        <DataGridTextColumn Header="下次扣款日" Binding="{Binding NextDateString}" Width="136" />
                                        <DataGridTextColumn Header="帳號" Binding="{Binding Account}" Width="170" />
                                        <DataGridTextColumn Header="備註" Binding="{Binding Note}" Width="*" />
                                        <DataGridTextColumn Header="建立時間" Binding="{Binding CreatedAtString}" Width="148" />
                                        <DataGridTextColumn Header="更新時間" Binding="{Binding UpdatedAtString}" Width="148" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Visibility="{Binding IsOilMonitorView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="最新 OQD Marker" Foreground="#8EAAD2" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OilCurrentPriceDisplay}" Margin="0,10,0,4" Foreground="{StaticResource StrongTextBrush}" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OilMarkerDateDisplay}" Foreground="{StaticResource SubtleBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="最近抓取" Foreground="#8EAAD2" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OilLastFetchDisplay}" Margin="0,10,0,4" Foreground="{StaticResource StrongTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="每天 13:00 自動抓取" Foreground="{StaticResource SuccessBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="資料來源" Foreground="#8EAAD2" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Gulf Mercantile Exchange" Margin="0,10,0,4" Foreground="{StaticResource StrongTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="https://www.gulfmerc.com/" Foreground="{StaticResource SubtleBrush}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="1" Background="{StaticResource WindowSurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,1,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#111E33" BorderBrush="#203150" BorderThickness="0,0,0,1" CornerRadius="23,23,0,0" Padding="18,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="OIL MARKER TREND" Foreground="{StaticResource StrongTextBrush}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding OilStatusMessage}" Foreground="#839CC0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="20">
                                        <Canvas x:Name="OilChartCanvas" Background="#101B2E" SizeChanged="OilChartCanvas_SizeChanged" />
                                        <TextBlock Text="尚無原油歷史資料" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource SubtleBrush}" Visibility="{Binding OilChartEmptyVisibility}" />
                                    </Grid>
                                </Grid>
                                <Border Grid.Column="1" Background="#101B2E" CornerRadius="0,23,23,0" Padding="18" BorderBrush="#203150" BorderThickness="1,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最近紀錄" Foreground="{StaticResource StrongTextBrush}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="每天 13:00 自動補點，手動刷新也會更新今日資料" Margin="0,8,0,0" Foreground="{StaticResource SubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ListBox Grid.Row="2" ItemsSource="{Binding OilRecentRecords}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource StrongTextBrush}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="14" Background="#162640" BorderBrush="#29456B" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding MarkerDateDisplay}" Foreground="{StaticResource StrongTextBrush}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding CapturedAtDisplay}" Margin="0,4,0,0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}" Foreground="{StaticResource HighlightSoftBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="6" HorizontalAlignment="Right" Foreground="#6C84A8" FontSize="11" FontWeight="SemiBold" Text="{Binding FooterText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
